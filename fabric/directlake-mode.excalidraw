    {
      "id": "dAjGPynLuLv48YEfCaK_m",
      "type": "text",
      "x": 1369.6680603027344,
      "y": 727.1937364330341,
      "width": 351.99951171875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1101425628,
      "version": 377,
      "versionNonce": 660388211,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794459431036,
      "link": null,
      "locked": false,
      "text": "Direct Lake reads Delta tables from\nOneLake into the same VertiPaq engine as\nImport – no copy, no full refresh. A\n\"refresh\" is just framing (a metadata\npointer move that takes seconds), and\ncolumns load into memory only when a\nquery first needs them (transcoding)\n - Framing (metadata sync, seconds)\n - Transcoding (on-demand column load)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "pbZ823HY6KjUTTTBeqKcs",
      "originalText": "Direct Lake reads Delta tables from OneLake into the same VertiPaq engine as Import – no copy, no full refresh. A \"refresh\" is just framing (a metadata pointer move that takes seconds), and columns load into memory only when a query first needs them (transcoding)\n - Framing (metadata sync, seconds)\n - Transcoding (on-demand column load)",
      "autoResize": true,
      "lineHeight": 1.25
    },
