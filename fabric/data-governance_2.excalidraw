    },
    {
      "id": "vAIf94xNPjIgsgqkT0fsh",
      "type": "text",
      "x": 1406.9580078125,
      "y": 209.79242556976504,
      "width": 258.8478088378906,
      "height": 237.60000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1057850329,
      "version": 297,
      "versionNonce": 329189143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787024997215,
      "link": null,
      "locked": false,
      "text": "** Domains organize assets around\nbusiness areas such as Finance, HR,\nSales, or Customer Data.\n\n** Governance can be delegated to\ndomain owners\n\n** Tags apply an organizational\ntaxonomy such as cost center,\nproject, regulatory category, or data\ntier.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Sce04-N3S_a-c6KzWSLrF",
      "originalText": "** Domains organize assets around business areas such as Finance, HR, Sales, or Customer Data.\n\n** Governance can be delegated to domain owners\n\n** Tags apply an organizational taxonomy such as cost center, project, regulatory category, or data tier.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "FAmeeRgyeg83y9krZa6Sh",
      "type": "rectangle",
      "x": 1408.363274468316,
      "y": 524.2211131104552,
      "width": 296.43701171875,
      "height": 322.299072265625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
