    {
      "id": "RYS6KSvbAVinUNUfv50VS",
      "type": "text",
      "x": 1413.363274468316,
      "y": 534.1706492432677,
      "width": 283.0557861328125,
      "height": 302.40000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 523666841,
      "version": 555,
      "versionNonce": 657013017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787025145940,
      "link": null,
      "locked": false,
      "text": "** Fabric integrates with Microsoft\nPurview Information Protection. \n\n** Labels such as Public, Internal,\nConfidential, or Highly Confidential can\nclassify Fabric items.\n\n** Labels can drive:\n     - Protection policies\n     - Access restrictions\n     - Export protection\n     - Default labeling\n     - Data loss prevention policies\n     - Compliance monitoring",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "FAmeeRgyeg83y9krZa6Sh",
      "originalText": "** Fabric integrates with Microsoft Purview Information Protection. \n\n** Labels such as Public, Internal, Confidential, or Highly Confidential can classify Fabric items.\n\n** Labels can drive:\n     - Protection policies\n     - Access restrictions\n     - Export protection\n     - Default labeling\n     - Data loss prevention policies\n     - Compliance monitoring",
      "autoResize": true,
      "lineHeight": 1.35
    }
