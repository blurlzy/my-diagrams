    {
      "id": "V3Nm8TsXr9LF5fWRAY-R6",
      "type": "text",
      "x": 272.7474212646484,
      "y": 749.8608887045307,
      "width": 941.5986938476562,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1689051703,
      "version": 123,
      "versionNonce": 1310070455,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787025021160,
      "link": null,
      "locked": false,
      "text": "Fabric governs the asset lifecycle inside the analytics platform, while Purview adds organization-wide\ncataloging, classification, policy, DLP, and audit. I’m doing one focused check on permission layers so the\nsecurity explanation doesn’t blur discovery, authorization, and protection.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "3sAPV2ifqGmdk15x8CEHO",
      "originalText": "Fabric governs the asset lifecycle inside the analytics platform, while Purview adds organization-wide cataloging, classification, policy, DLP, and audit. I’m doing one focused check on permission layers so the security explanation doesn’t blur discovery, authorization, and protection.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Sce04-N3S_a-c6KzWSLrF",
      "type": "rectangle",
      "x": 1401.9580078125,
      "y": 189.901980623476,
      "width": 280.54101562500006,
      "height": 277.3808898925781,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
